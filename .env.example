# Required for export. Preview works without any of these.

# From the Vercel Blob store connected to this project:
# Vercel Dashboard → Storage → Blob → .env.local, or `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# From RunPod: Settings → API Keys.
RUNPOD_API_KEY=

# From the deployed Serverless endpoint URL / dashboard ID.
# Example: https://api.runpod.ai/v2/<this-value>/run
RUNPOD_ENDPOINT_ID=

# Optional limits. Defaults: image 20 MB, audio 200 MB, duration 60 minutes.
MAX_IMAGE_UPLOAD_MB=20
MAX_AUDIO_UPLOAD_MB=200
MAX_AUDIO_DURATION_SECONDS=3600
